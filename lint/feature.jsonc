{
  // Feature card, written by the Product Owner.
  //
  // Why five configs and not one: MD043 (required-headings) holds a single
  // heading list for the whole lint run, and it applies that one list to every
  // file matched. We have five artifact types with five different mandatory
  // structures, so one config would either accept all five (and check nothing)
  // or reject four out of five. The config is therefore chosen per file, by the
  // `type` field of its frontmatter — feature -> this file.
  "extends": "../.markdownlint.jsonc",

  // The heading of a card is its title on the board, not a line in its body.
  "MD041": false,

  // Placeholders are written in angle brackets and read as inline HTML.
  "MD033": false,

  // GENERATED HEADINGS. The `MD043` list below mirrors `registry/sections.json`,
  // which is where a section's identity and its wording are defined (IDE-132).
  // Edit that table, not this list — `scripts/sections.py --check-lint`, and a
  // test, refuse to let the two disagree. The headings are rendered in the
  // table's `default_language`; `scripts/validate.py` reads the table directly
  // and accepts an artifact in any language it defines.

  // "*" matches zero or more free headings, so a rich document is allowed to
  // add its own sections between the mandatory ones. The mandatory headings
  // themselves must appear, in this order, and the first of them opens the file.
  "MD043": {
    "headings": [
      "## Why",
      "*",
      "## What we build",
      "*",
      "## What proves it",
      "*",
      "## What we are not doing",
      "*"
    ]
  }
}
