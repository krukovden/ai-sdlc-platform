{
  // Project ADR — the architecture of a whole system, attached to the epic.
  //
  // A sixth config because MD043 holds one heading list per lint run and a
  // project ADR carries a section a feature ADR does not: Этапы, the delivery
  // order. The config is chosen by `type` **and** `scope`: adr + scope:project
  // -> this file, adr alone -> adr.jsonc. That is the only place in the lint
  // layer where two header fields select a config, and it is why `scope` is a
  // field rather than another value of `route`.
  "extends": "../.markdownlint.jsonc",

  // The document title is the attachment title on the epic.
  "MD041": false,

  // GENERATED HEADINGS. The `MD043` list below mirrors `registry/sections.json`,
  // which is where a section's identity and its wording are defined (IDE-132).
  // Edit that table, not this list — `scripts/sections.py --check-lint`, and a
  // test, refuse to let the two disagree. The headings are rendered in the
  // table's `default_language`; `scripts/validate.py` reads the table directly
  // and accepts an artifact in any language it defines.

  // Placeholders are written in angle brackets and read as inline HTML.
  "MD033": false,

  "MD043": {
    "headings": [
      "## Why",
      "*",
      "## What we build",
      "*",
      "## Stages",
      "*",
      "## What proves it",
      "*",
      "## What this document does not decide",
      "*",
      "## What it costs us",
      "*"
    ]
  }
}
