{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/platform-freshness/check.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/context_watch.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "( python3 \"${CLAUDE_PLUGIN_ROOT}/skills/platform-telemetry/detect.py\" ) >/dev/null 2>&1; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "( python3 \"${CLAUDE_PLUGIN_ROOT}/skills/platform-telemetry/detect.py\" ) >/dev/null 2>&1; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/cliff_handoff.py\" --host claude",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
