{
  "version": 1,
  "hooks": {
    "errorOccurred": [
      {
        "type": "command",
        "bash": "python3 \"${IDP_PLATFORM_ROOT}/scripts/hooks/cliff_handoff.py\" --host copilot --event errorOccurred",
        "timeoutSec": 120
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "python3 \"${IDP_PLATFORM_ROOT}/scripts/hooks/cliff_handoff.py\" --host copilot --event sessionEnd",
        "timeoutSec": 120
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "( python3 \"${IDP_PLATFORM_ROOT}/skills/platform-telemetry/detect.py\" ) >/dev/null 2>&1; exit 0",
        "timeoutSec": 30
      }
    ]
  }
}
